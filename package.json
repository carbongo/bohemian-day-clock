{
  "name": "bohemian-day-clock",
  "version": "2.1.0",
  "description": "Your whole day on one turning dial: daylight, night, sunrise and sunset for your city.",
  "private": true,
  "source": "src/index.html",
  "scripts": {
    "start": "parcel src/index.html --port 8000",
    "build": "parcel build src/index.html --dist-dir public --public-url ./ --no-source-maps && node scripts/inline-output.mjs public/index.html",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "desktop:package": "node scripts/desktop.mjs",
    "desktop": "npm run build && npm run desktop:package"
  },
  "targets": {
    "default": {
      "distDir": "public"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carbongo/bohemian-day-clock.git"
  },
  "author": "Georgii Antipin (https://github.com/carbongo)",
  "license": "ISC",
  "keywords": [
    "clock",
    "24-hour-clock",
    "sunrise",
    "sunset",
    "daylight",
    "desktop-app",
    "pake",
    "react",
    "tailwind"
  ],
  "bugs": {
    "url": "https://github.com/carbongo/bohemian-day-clock/issues"
  },
  "homepage": "https://bohemian-day-clock.vercel.app",
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@parcel/optimizer-data-url": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-js": "^2.12.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "parcel": "^2.12.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
